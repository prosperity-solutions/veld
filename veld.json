{
  "$schema": "https://veld.oss.life.li/schema/v3/veld.schema.json",
  "schemaVersion": "3",
  "name": "veld",
  "url_template": "{service}.{run}.veld.localhost",
  "ide": {
    "quicklinks": [
      { "label": "veld.oss.life.li", "url": "https://veld.oss.life.li" },
      { "label": "GitHub", "url": "https://github.com/prosperity-solutions/veld" },
      { "label": "Google", "url": "https://www.google.com" }
    ],
    "permissions": [
      // Two wildcards, both load-bearing.
      //
      // `*.` because this project's URLs are {service}.{run}.veld.localhost, so
      // the run name is *in the hostname* and changes with the worktree, the
      // branch, or --name. A pinned host would grant to exactly one run.
      //
      // `:*` because an omitted port means the scheme's DEFAULT port, and only a
      // privileged install serves on 443 — `veld setup unprivileged` (the no-sudo
      // default) uses 18443, where `https://*.veld.localhost` matches nothing at
      // all and the grant silently never applies.
      //
      // `display-capture` is already veld's default at an origin veld serves —
      // it is what makes `veld feedback` screenshots work inside a browser pane.
      // Written out anyway, because a default is invisible and this file is where
      // someone looks to find out what the project granted.
      {
        "origin": "https://*.veld.localhost:*",
        "allow": ["notifications", "display-capture"]
      }
    ],
    // Dogfooding, and the worked examples: this is a repo whose contributors
    // run a coding agent in a terminal all day. Note that nothing about
    // `claude` or `codex` is known to veld — they are names in this file, the
    // same way `npx browser-sync` below is.
    //
    // The two agents demonstrate the **two shapes** a resumable pane can take,
    // which is why both are here rather than one:
    //
    //   claude — accepts an id veld chose, so each pane owns its own
    //            conversation and two panes never collide.
    //   codex  — mints its own id and cannot be told one, so the pane carries
    //            no token and leans on the tool's own "most recent session".
    //
    // Both are offered in **auto mode only**. There used to be a second Claude
    // pane running `--dangerously-skip-permissions`; it is gone on purpose, so
    // that the panes this repo hands a contributor are the ones that still stop
    // and ask. Run the unsandboxed variant from a plain terminal if you want it.
    "panes": [
      {
        "id": "claude",
        "type": "terminal",
        "label": "Claude - auto",
        "description": "Claude Code in this worktree, in auto permission mode",
        "icon": "robot",
        "requires_bin": ["claude"],
        // This moved in both directions, so read it as both. Against the pane
        // that is gone (`--dangerously-skip-permissions`) it is a tightening:
        // the one Claude pane this repo offers still stops and asks. Against
        // what *this* pane used to be — no mode flag at all, i.e. the CLI's own
        // default — `auto` is a loosening, chosen deliberately because a pane a
        // contributor keeps for a whole session is worth fewer prompts. What
        // `auto` gates is the CLI's business and is not documented here; check
        // `claude --help` for the current set rather than trusting this comment.
        //
        // `--session-id` creates the conversation under an id veld chose, which
        // is what makes the `resume` below able to name it after a reboot.
        "argv": [
          "claude",
          "--permission-mode",
          "auto",
          "--session-id",
          "${veld.pane.token}"
        ],
        // Repeated on resume: the pane's label promises auto mode, and a
        // resumed session that quietly came back in a different one would make
        // that label a lie for the rest of the conversation.
        "resume": {
          "argv": [
            "claude",
            "--resume",
            "${veld.pane.token}",
            "--permission-mode",
            "auto"
          ]
        },
        "auto_resume": true
      },
      {
        // The other shape. `codex` has no launch-time session-id flag — it
        // mints its own UUID — so there is nothing to interpolate
        // `${veld.pane.token}` into, and the pane simply does not use one.
        //
        // `codex resume` takes a session id, but since we cannot choose it,
        // `--last` is the reachable handle: continue the most recent session.
        // Codex's own resume filters by working directory unless `--all` is
        // passed, so "most recent" means most recent *in this worktree*.
        //
        // The cost of having no token, and the reason the claude pane above
        // has one: two Codex panes open in the same worktree would both resume
        // the same session, because "the most recent one" is a single answer.
        "id": "codex",
        "type": "terminal",
        "label": "Codex - auto",
        "description": "Codex CLI in this worktree, in auto mode",
        "icon": "robot",
        "requires_bin": ["codex"],
        // Codex has no `--permission-mode`; its "Auto" preset is these two
        // flags — write inside the workspace freely, ask before stepping
        // outside it. Spelled out rather than left to `~/.codex/config.toml`,
        // so the pane's label describes what it actually starts.
        "argv": [
          "codex",
          "--sandbox",
          "workspace-write",
          "--ask-for-approval",
          "on-request"
        ],
        "resume": {
          "argv": [
            "codex",
            "resume",
            "--last",
            "--sandbox",
            "workspace-write",
            "--ask-for-approval",
            "on-request"
          ]
        },
        // Left off deliberately, so the two agent panes differ in this too:
        // Claude resumes itself when Veld Desktop restarts, Codex waits for a
        // click. Flip it to true if you prefer the other trade.
        "auto_resume": false
      },
      {
        // The third shape: one-shot. No resume, no token, an emoji instead of
        // an icon name — a pane needs none of the machinery to be worth having.
        //
        // Deliberately does *not* `exec $SHELL -l` afterwards. Git pages its
        // log, so `q` quits the pager, git exits, the shell exits 0, and
        // `close_on_exit` tidies the pane away — which is what pressing `q`
        // ought to mean. Dropping into a shell instead left the pane sitting at
        // a prompt nobody asked for.
        "id": "git-log",
        "type": "terminal",
        "label": "Git log",
        "icon": "📜",
        "requires_bin": ["git"],
        // Quoted, and `argv` would be better still — see the note on quoting
        // in docs/configuration.md. A path with a space in it is the everyday
        // reason; `${veld.branch}` is the sharp one, since a branch name can
        // come from someone else's pull request.
        "shell": "git -C \"${veld.root}\" log --oneline --graph --decorate -40"
      }
    ]
  },
  // Dogfooding again, for machine-overridable vars this time. Both of these are
  // facts about *your machine*, not about this project, which is the whole test
  // for whether something belongs here rather than as a plain value: nothing
  // about the veld website differs between contributors, but how noisy you want
  // its server while you debug something, and how long your filesystem takes to
  // settle after a save, both do.
  //
  // Both carry a `default` that reproduces browser-sync's own behaviour, so a
  // fresh clone and CI are unaffected and nobody has to answer anything. Change
  // yours with `veld config set`, never by editing this file — the declaration is
  // shared, the answer is not:
  //
  //   veld config vars
  //   veld config set website_log_level debug
  //   veld config unset website_log_level
  //
  // The two also show the two shapes a machine var takes. `website_log_level` is
  // a **closed** set, so `choices` can enumerate it and veld refuses anything
  // else at set time. `website_reload_delay` is **open** — any number of
  // milliseconds — so today nothing validates it beyond being a string, which is
  // the gap tracked in #227.
  "vars": {
    "website_log_level": {
      "machine": {
        "default": "info",
        "choices": ["silent", "info", "debug"],
        "description": "How loud the local website server is. `debug` when you are chasing a proxy or reload problem; `silent` when it is just in the way."
      }
    },
    "website_reload_delay": {
      "machine": {
        "default": "0",
        "description": "Milliseconds to wait before reloading the browser after a save. Raise it if this machine's editor or filesystem reports the write before it has landed (network mounts and some VM-shared checkouts do)."
      }
    }
  },
  "nodes": {
    "website": {
      "default_variant": "local",
      "variants": {
        "local": {
          "type": "start_server",
          "argv": ["npx","--yes","browser-sync","start","--server","website","--watch","--port","${veld.port}","--no-open","--no-ui","--logLevel","${vars.website_log_level}","--reload-delay","${vars.website_reload_delay}"],
          "health_check": { "type": "http", "path": "/index.html", "timeout_seconds": 30 }
        }
      }
    }
  }
}
