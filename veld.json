{
  "$schema": "https://veld.oss.life.li/schema/v3/veld.schema.json",
  "schemaVersion": "3",
  "name": "veld",
  "url_template": "{service}.{run}.veld.localhost",
  "ide": {
    // This repo merges often and its agents live in worktrees, so "behind"
    // should read urgent sooner rather than later — the staleness pill colours
    // at half the baseline thresholds.
    "git": {
      "stalenessSensitivity": 2
    },
    "quicklinks": [
      { "label": "veld.oss.life.li", "url": "https://veld.oss.life.li" },
      { "label": "GitHub", "url": "https://github.com/prosperity-solutions/veld" },
      { "label": "Google", "url": "https://www.google.com" }
    ],
    "permissions": [
      // Two wildcards, both load-bearing.
      //
      // `*.` because this project's URLs are {service}.{run}.veld.localhost, so
      // the run name is *in the hostname* and changes with the worktree, the
      // branch, or --name. A pinned host would grant to exactly one run.
      //
      // `:*` because an omitted port means the scheme's DEFAULT port, and only a
      // privileged install serves on 443 — `veld setup unprivileged` (the no-sudo
      // default) uses 18443, where `https://*.veld.localhost` matches nothing at
      // all and the grant silently never applies.
      //
      // `display-capture` is already veld's default at an origin veld serves —
      // it is what makes `veld feedback` screenshots work inside a browser pane.
      // Written out anyway, because a default is invisible and this file is where
      // someone looks to find out what the project granted.
      {
        "origin": "https://*.veld.localhost:*",
        "allow": ["notifications", "display-capture"]
      }
    ],
    // Dogfooding the extension system, and the worked example for it. Nothing
    // here is known to veld: `gh`, `webstorm` and `code` are names in this file,
    // the same way `claude` is in the panes below.
    //
    // Note the two shapes a declaration takes. An entry **with** a `slot`
    // renders there; one **without** is declared to be referenced — by the
    // menu's `items`, or by the `pr` badge's own output — which is what keeps
    // three editor buttons out of a 42px bar.
    "extensions": [
      {
        // The badge runs scripts/veld/pr-badge.sh, which is the whole
        // provider-specific half: it knows `gh`, and veld only ever sees the
        // small badge contract the script prints. Swap the script for one
        // calling `glab` and this declaration does not change.
        "id": "pr",
        "slot": "topBar",
        "type": "status",
        "label": "PR",
        // The declaration's glyph. A badge's output may override it per state
        // (`"icon": "git-merge"` once merged), which is what makes a glyph track
        // the thing it describes.
        "icon": "git-pull-request",
        // Explicit, though `system` is already the default: a pull request is
        // behind a login the developer holds in their *own* browser, and a Veld
        // browser pane has a separate cookie jar, so opening it in a pane is a
        // second sign-in at best. Written out because this file is where someone
        // copying the pattern will look for the choice.
        "open_in": "system",
        "argv": ["scripts/veld/pr-badge.sh"],
        "refresh_seconds": 60,
        "requires_bin": ["gh"],
        // `hint` rather than `hide`: a fresh clone should *say* what this repo
        // expects you to have, and the href opens the install page.
        "when_missing": "hint",
        "hint": {
          "text": "Install the GitHub CLI to see this branch's pull request.",
          "href": "https://cli.github.com"
        }
      },
      {
        // No `slot`: this exists to be named by the `pr` badge's output when the
        // branch has no pull request yet. veld resolves that id against this
        // file before offering it, so the badge chooses among declared actions
        // and can never contribute one.
        "id": "create-pr",
        "type": "action",
        "label": "Create a pull request",
        "argv": ["gh", "pr", "create", "--web"],
        "requires_bin": ["gh"]
      },
      {
        "id": "open-in",
        "slot": "topBar",
        "type": "menu",
        "label": "Open this worktree in",
        // `external-link`, not `code`: the `</>` glyph reads as "source code"
        // rather than "hand this to another application".
        "icon": "external-link",
        "items": ["vscode", "webstorm"]
      },
      // **No `requires_bin` on the editors, and that is the interesting part.**
      // Every one of these ships a command-line launcher that is *not installed
      // by default* — VS Code needs "Shell Command: Install 'code' command in
      // PATH", JetBrains needs the Toolbox shell scripts — so a PATH check hides
      // the option on a machine where the editor is sitting right there in
      // /Applications. Hiding a working option is a worse failure than offering
      // one that explains itself, and these live inside a menu, so an entry that
      // might not work costs a line in a popover rather than space in the bar.
      //
      // So each tries the launcher and falls back to the application bundle.
      // `open -a` exits non-zero when the app is genuinely absent, and veld turns
      // that into a toast carrying the reason. `${veld.root}` is quoted because a
      // checkout path can contain spaces.
      //
      // The general gap this works around is recorded in
      // docs/extensions-vision.md: `requires_bin` cannot express "this GUI
      // application is installed", which is a first-class case for the very
      // feature it is being used for.
      {
        "id": "vscode",
        "type": "action",
        "label": "VS Code",
        "shell": "command -v code >/dev/null 2>&1 && exec code \"${veld.root}\" || exec open -a \"Visual Studio Code\" \"${veld.root}\""
      },
      {
        "id": "webstorm",
        "type": "action",
        "label": "WebStorm",
        "shell": "command -v webstorm >/dev/null 2>&1 && exec webstorm \"${veld.root}\" || exec open -a WebStorm \"${veld.root}\""
      }
    ],
    // Dogfooding, and the worked examples: this is a repo whose contributors
    // run a coding agent in a terminal all day. Note that nothing about
    // `claude` or `codex` is known to veld — they are names in this file, the
    // same way `npx browser-sync` below is.
    //
    // These panes demonstrate the **two shapes** a resumable pane can take:
    //
    //   claude / claude-sonnet / pi — each accepts an id veld chose, so every
    //            pane owns its own conversation and two panes never collide.
    //   codex  — mints its own id and cannot be told one, so the pane carries
    //            no token and leans on the tool's own "most recent session".
    //
    // `claude` and `claude-sonnet` are the same pane pinned to different
    // models (Opus, Sonnet) — the model that's pinned is what the label
    // names, so a resumed session can never drift out from under its label.
    //
    // All are offered in **auto mode only**. There used to be a second Claude
    // pane running `--dangerously-skip-permissions`; it is gone on purpose, so
    // that the panes this repo hands a contributor are the ones that still stop
    // and ask. Run the unsandboxed variant from a plain terminal if you want it.
    "panes": [
      {
        "id": "claude",
        "type": "terminal",
        "label": "Claude Opus",
        "description": "Claude Code (Opus) in this worktree, in auto permission mode",
        "icon": "robot",
        "requires_bin": ["claude"],
        // This moved in both directions, so read it as both. Against the pane
        // that is gone (`--dangerously-skip-permissions`) it is a tightening:
        // the one Claude pane this repo offers still stops and asks. Against
        // what *this* pane used to be — no mode flag at all, i.e. the CLI's own
        // default — `auto` is a loosening, chosen deliberately because a pane a
        // contributor keeps for a whole session is worth fewer prompts. What
        // `auto` gates is the CLI's business and is not documented here; check
        // `claude --help` for the current set rather than trusting this comment.
        //
        // `--model opus` is pinned rather than left to the CLI's own default,
        // because the label says "Opus" — an unpinned model would drift out
        // from under a label that stopped being true.
        //
        // `--session-id` creates the conversation under an id veld chose, which
        // is what makes the `resume` below able to name it after a reboot.
        "argv": [
          "claude",
          "--permission-mode",
          "auto",
          "--model",
          "opus",
          "--session-id",
          "${veld.pane.token}"
        ],
        // Repeated on resume: the pane's label promises auto mode on Opus, and
        // a resumed session that quietly came back in a different mode or
        // model would make that label a lie for the rest of the conversation.
        "resume": {
          "argv": [
            "claude",
            "--resume",
            "${veld.pane.token}",
            "--permission-mode",
            "auto",
            "--model",
            "opus"
          ]
        },
        "auto_resume": true
      },
      {
        // Same shape as `claude` above, pinned to Sonnet instead of Opus —
        // a distinct pane rather than a variant of the other, because the
        // token is per-pane: two panes means two independent conversations
        // that can both be open at once.
        "id": "claude-sonnet",
        "type": "terminal",
        "label": "Claude Sonnet",
        "description": "Claude Code (Sonnet) in this worktree, in auto permission mode",
        "icon": "robot",
        "requires_bin": ["claude"],
        "argv": [
          "claude",
          "--permission-mode",
          "auto",
          "--model",
          "sonnet",
          "--session-id",
          "${veld.pane.token}"
        ],
        "resume": {
          "argv": [
            "claude",
            "--resume",
            "${veld.pane.token}",
            "--permission-mode",
            "auto",
            "--model",
            "sonnet"
          ]
        },
        "auto_resume": true
      },
      {
        // A third shape variant, but the same family as `claude` above: `pi`
        // also accepts a caller-chosen session id (`--session-id`, which the
        // CLI creates if missing), so it gets a real token and a real resume
        // rather than codex's `--last` guess.
        //
        // Any pane runs inside your **login+interactive shell** (`$SHELL -l -i
        // -c '<command>'`), the same shell a normal terminal opens — so an `argv`
        // here inherits whatever `.zprofile`/`.zshrc` export (model tokens,
        // tool paths), exactly as if you had typed the command in a terminal.
        // The shell still exits with the command's status, so `close_on_exit`
        // and resume behave as before.
        "id": "pi",
        "type": "terminal",
        "label": "Pi - auto",
        "description": "Pi CLI in this worktree, resumable",
        "icon": "robot",
        "requires_bin": ["pi"],
        "argv": [
          "pi",
          "--session-id",
          "${veld.pane.token}"
        ],
        // Same flag on resume: `--session-id` both selects an existing
        // session and creates one if the id is somehow unknown, so there is
        // no separate "resume" invocation to write, unlike claude's `--resume`.
        "resume": {
          "argv": [
            "pi",
            "--session-id",
            "${veld.pane.token}"
          ]
        },
        "auto_resume": true
      },
      {
        // The other shape. `codex` has no launch-time session-id flag — it
        // mints its own UUID — so there is nothing to interpolate
        // `${veld.pane.token}` into, and the pane simply does not use one.
        //
        // `codex resume` takes a session id, but since we cannot choose it,
        // `--last` is the reachable handle: continue the most recent session.
        // Codex's own resume filters by working directory unless `--all` is
        // passed, so "most recent" means most recent *in this worktree*.
        //
        // The cost of having no token, and the reason the claude pane above
        // has one: two Codex panes open in the same worktree would both resume
        // the same session, because "the most recent one" is a single answer.
        "id": "codex",
        "type": "terminal",
        "label": "Codex - auto",
        "description": "Codex CLI in this worktree, in auto mode",
        "icon": "robot",
        "requires_bin": ["codex"],
        // Codex has no `--permission-mode`; its "Auto" preset is these two
        // flags — write inside the workspace freely, ask before stepping
        // outside it. Spelled out rather than left to `~/.codex/config.toml`,
        // so the pane's label describes what it actually starts.
        "argv": [
          "codex",
          "--sandbox",
          "workspace-write",
          "--ask-for-approval",
          "on-request"
        ],
        "resume": {
          "argv": [
            "codex",
            "resume",
            "--last",
            "--sandbox",
            "workspace-write",
            "--ask-for-approval",
            "on-request"
          ]
        },
        // Left off deliberately, so the two agent panes differ in this too:
        // Claude resumes itself when Veld Desktop restarts, Codex waits for a
        // click. Flip it to true if you prefer the other trade.
        "auto_resume": false
      },
      {
        // The third shape: one-shot. No resume, no token, an emoji instead of
        // an icon name — a pane needs none of the machinery to be worth having.
        //
        // Deliberately does *not* drop into an interactive prompt afterwards.
        // Git pages its log, so `q` quits the pager, git exits, and the login
        // shell wrapping the pane exits with its status — which is what
        // `close_on_exit` then tidies away. `q` means "this pane is done", not
        // "and now give me a shell".
        "id": "git-log",
        "type": "terminal",
        "label": "Git log",
        "icon": "📜",
        "requires_bin": ["git"],
        // Quoted, and `argv` would be better still — see the note on quoting
        // in docs/configuration.md. A path with a space in it is the everyday
        // reason; `${veld.branch}` is the sharp one, since a branch name can
        // come from someone else's pull request.
        "shell": "git -C \"${veld.root}\" log --oneline --graph --decorate -40"
      }
    ]
  },
  // Dogfooding again, for machine-overridable vars this time. Both of these are
  // facts about *your machine*, not about this project, which is the whole test
  // for whether something belongs here rather than as a plain value: nothing
  // about the veld website differs between contributors, but how noisy you want
  // its server while you debug something, and how long your filesystem takes to
  // settle after a save, both do.
  //
  // Both carry a `default` that reproduces browser-sync's own behaviour, so a
  // fresh clone and CI are unaffected and nobody has to answer anything. Change
  // yours with `veld config set`, never by editing this file — the declaration is
  // shared, the answer is not:
  //
  //   veld config vars
  //   veld config set website_log_level debug
  //   veld config unset website_log_level
  //
  // The two also show the two shapes a machine var takes. `website_log_level` is
  // a **closed** set, so `choices` can enumerate it and veld refuses anything
  // else at set time. `website_reload_delay` is **open** — any number of
  // milliseconds — so today nothing validates it beyond being a string, which is
  // the gap tracked in #227.
  "vars": {
    "website_log_level": {
      "machine": {
        "default": "info",
        "choices": ["silent", "info", "debug"],
        "description": "How loud the local website server is. `debug` when you are chasing a proxy or reload problem; `silent` when it is just in the way."
      }
    },
    "website_reload_delay": {
      "machine": {
        "default": "0",
        "description": "Milliseconds to wait before reloading the browser after a save. Raise it if this machine's editor or filesystem reports the write before it has landed (network mounts and some VM-shared checkouts do)."
      }
    }
  },
  // `veld start` with no arguments offers these. Keys are pinned, because they
  // are the numbers a contributor types.
  // Each dev preset names the `dev-db` variant it wants, so the database mode
  // is part of the thing you start rather than a flag to remember.
  //
  // Naming a variant does not REPLACE the `dev-db:ensure` that `dev-daemon`
  // depends on — veld's plan is keyed on (node, variant), so both run, in the
  // same stage, before the daemon. That is exactly why `ensure` does nothing
  // but create the directory. It also means **no preset may combine `fresh`
  // with `from-real`**: those two would race each other rather than compose.
  "presets": {
    "dev": {
      "key": 1,
      "selections": ["dev-db:fresh", "dev-electron:local", "dev-link:local"],
      "when_to_use": "The everyday one: this worktree's stack on an EMPTY database — daemon, /ide with HMR, and the Electron shell. Parallel-safe: every port, database and hostname is this run's. Note it starts with no imported repos or worktrees; use dev-keep to carry them over."
    },
    "dev-headless": {
      "key": 2,
      "selections": ["dev-db:fresh", "dev-ui:local", "dev-link:local"],
      "when_to_use": "The same, empty database and no Electron shell — open /ide in a browser tab instead."
    },
    "dev-keep": {
      "key": 3,
      "selections": ["dev-electron:local", "dev-link:local"],
      "when_to_use": "Reuse whatever this run's database already holds, instead of starting empty. What you want once you have imported repos and arranged worktrees and would rather not do it again."
    },
    "dev-from-real": {
      "key": 4,
      "selections": ["dev-db:from-real", "dev-electron:local", "dev-link:local"],
      "when_to_use": "Migration rehearsal: snapshot the REAL installed database into this run's and start on the copy. The real file is never written. Run this before merging anything that adds a migration. macOS only today."
    },
    "website": {
      "key": 5,
      "selections": ["website:local"],
      "when_to_use": "Just the marketing site, for `veld feedback` on copy and design."
    }
  },
  "nodes": {
    "website": {
      "default_variant": "local",
      "variants": {
        "local": {
          "type": "long_running",
          "argv": ["npx","--yes","browser-sync","start","--server","website","--watch","--port","${veld.port}","--no-open","--no-ui","--logLevel","${vars.website_log_level}","--reload-delay","${vars.website_reload_delay}"],
          "health_check": { "type": "http", "path": "/index.html", "timeout_seconds": 30 }
        }
      }
    },

    // ── The dev stack ────────────────────────────────────────────────────
    //
    // veld running veld. The point is **parallel worktrees**: everything below
    // is keyed off `${veld.run}` or a port veld allocated, so two checkouts can
    // each have a full dev stack up at once. That used to be impossible — the
    // justfile hardcoded one daemon port, one socket, one dashboard hostname
    // and one `~/.local/bin/veld-dev`, so whichever worktree started second
    // died on `another veld-daemon is already running`.
    //
    // The justfile's `just dev` / `just dev-daemon` tier still exists and is
    // still a singleton. It is the BOOTSTRAP tier, deliberately: you need a way
    // to run the daemon when what you broke is `veld start` itself.
    //
    // Which instance owns this run? The **installed** veld. It starts and
    // monitors these nodes; the daemon one of them runs is a separate instance
    // with its own database. So a schema-ahead branch cannot touch your real
    // state, and `veld status` still works while the dev daemon is wedged.
    //
    // The paths every node here shares. `${veld.root}` rather than a relative
    // path because a `cwd` moves the goalposts, and `.veld-dev/` is gitignored.
    "dev-build": {
      "env": { "VELD_DEV_ROOT": "${veld.root}" },
      "default_variant": "local",
      "variants": {
        "local": {
          // `command`, so it runs to completion and gates everything after it.
          // A build failure should stop the run here rather than let three
          // long-running nodes start against a half-built tree.
          "type": "command",
          "argv": ["${veld.root}/scripts/dev/build.sh"]
        }
      }
    },

    "dev-db": {
      "env": { "VELD_DEV_DIR": "${veld.root}/.veld-dev/${veld.run}" },
      // `ensure` is the default because it is what `dev-daemon` DEPENDS on, and
      // a dependency pins one variant. Naming another (as the presets do) adds
      // a second node rather than replacing this one: veld's plan is keyed on
      // (node, variant), so `dev-db:ensure` and `dev-db:fresh` both run, in the
      // same stage, concurrently — and both finish before `dev-daemon` starts,
      // so the daemon opens whatever the named variant left.
      //
      // That only works because `ensure` writes nothing. Give it something to
      // do and it starts racing the variant the user actually asked for. It is
      // named for what it is — create the directory — rather than `keep`, which
      // read like a mode and invited exactly that mistake.
      "default_variant": "ensure",
      "variants": {
        "ensure":    { "type": "command", "argv": ["${veld.root}/scripts/dev/db.sh", "ensure"] },
        "fresh":     { "type": "command", "argv": ["${veld.root}/scripts/dev/db.sh", "fresh"] },
        "from-real": { "type": "command", "argv": ["${veld.root}/scripts/dev/db.sh", "from-real"] }
      }
    },

    "dev-daemon": {
      "depends_on": { "dev-build": "local", "dev-db": "ensure" },
      // ⚠ This map contains cross-node references (`${nodes.dev-ui.*}` below),
      // which is safe ONLY because this node has no `on_stop`. A node's `env` is
      // re-resolved for its stop hook, `build_env` is all-or-nothing, and
      // `${nodes.*}` does not resolve once the run is stopping — so adding an
      // `on_stop` here would empty the whole map and the hook would run blind.
      // That is not hypothetical: it is the bug `scripts/dev/link.sh` documents
      // fixing, which is why THAT node's env is builtins-only. Add an `on_stop`
      // to this node and you must move that entry out of `env` first.
      "env": {
        "VELD_DEV_ROOT": "${veld.root}",
        "VELD_DEV_RUN": "${veld.run}",
        "VELD_DB_PATH": "${veld.root}/.veld-dev/${veld.run}/veld.db",
        // veld allocated this; the daemon serves its API and /ide on it, and
        // it is what makes this daemon a different *instance* from yours.
        "VELD_DAEMON_PORT": "${veld.port}",
        // Origins allowed to open a terminal through this daemon, beyond its
        // own (which veld hands it in VELD_URL, so it is not restated here).
        // The name is the invariant: these are the origins that same-origin
        // **proxy** this daemon's /api — which is exactly what the vite dev
        // server below does, and why the browser's Origin on a terminal
        // upgrade is vite's rather than the daemon's. Only ever honoured off
        // the default daemon port; see `veld_core::instance`.
        //
        // Both spellings of vite's loopback address, because which one you get
        // depends on how you opened the page, and the check is exact-match.
        //
        // This makes `dev-daemon` NOT independently startable: it references a
        // node that does not depend on it (the edge runs the other way), and
        // `build_env` is all-or-nothing, so `veld start dev-daemon` fails with
        // `unresolved variable reference: ${nodes.dev-ui.url}`. Every preset
        // pulls `dev-ui` in, so the supported paths are unaffected — but start
        // it by hand and you must name `dev-ui` too.
        "VELD_PROXY_ORIGINS": "${nodes.dev-ui.url},http://localhost:${nodes.dev-ui.port},http://127.0.0.1:${nodes.dev-ui.port}"
        //
        // Deliberately NOT set: VELD_MANAGEMENT_HOST. It makes the daemon
        // self-register a Caddy route under the id `veld-mgmt-<host>` — but
        // veld already routes this node, under `run_route_id(hostname)`. Two
        // route ids for one hostname is the case `crates/veld-core/src/url.rs`
        // says has no defined winner, and they have different lifetimes: the
        // daemon drops its route at shutdown, veld drops the run's at stop.
        // The bootstrap tier still sets it, because there nothing else routes.
      },
      "default_variant": "local",
      "variants": {
        "local": {
          "type": "long_running",
          // A script, not argv: the socket and holder directories must live
          // under $HOME to stay inside the 104-byte `sun_path` limit, and only
          // a shell can expand it. The script says why.
          "argv": ["${veld.root}/scripts/dev/daemon.sh"],
          "probes": {
            "readiness": { "type": "http", "path": "/api/health" },
            "liveness": { "type": "http", "path": "/api/health" }
          }
        }
      }
    },

    "dev-ui": {
      "depends_on": { "dev-daemon": "local" },
      "default_variant": "local",
      "variants": {
        "local": {
          "type": "long_running",
          "cwd": "crates/veld-daemon/ui",
          "argv": ["npm", "run", "dev"],
          "env": {
            // vite proxies /api — including the terminal WebSocket upgrade —
            // to the daemon this run started, not to the installed one.
            "VELD_DAEMON_PORT": "${nodes.dev-daemon.port}"
            // vite's own port and hostname arrive as VELD_PORT and VELD_URL,
            // which veld sets for every long-running node. vite.config.ts
            // reads both, so there is nothing to declare here.
          },
          "probes": { "readiness": { "type": "http", "path": "/" } }
        }
      }
    },

    "dev-electron": {
      "depends_on": { "dev-ui": "local" },
      // No `env` here on purpose. A node's `env` map reaches the node's own
      // process and NOTHING else — not an action, not a probe command (both
      // measured). The run directory therefore travels as an argument, and
      // `electron.sh` derives the repo root from its own path.
      "actions": [
        {
          "name": "open",
          "label": "Reopen Electron",
          "description": "Bring the Veld Desktop window back after you closed or quit it. The rest of the stack keeps running either way.",
          // An action's argv IS interpolated (a probe's is not).
          "argv": [
            "${veld.root}/scripts/dev/electron.sh",
            "--open",
            "${veld.root}/.veld-dev/${veld.run}"
          ]
        }
      ],
      "default_variant": "local",
      "variants": {
        "local": {
          "type": "long_running",
          // A supervisor, not `electron .` directly, and the reason is the
          // health monitor: it treats ANY node process dying as a crash of the
          // whole run and SIGTERMs every surviving sibling. Run bare, one Cmd+Q
          // took the dev daemon and vite down with it — measured. The node is
          // therefore the supervisor, which outlives a quit; the script says the
          // rest.
          // The second argument is the startup grace, and it MUST equal the
          // `settle` seconds below: an Electron that dies inside that window is
          // a failed start and takes the supervisor down with it, which is what
          // keeps `settle` an honest probe. See the script.
          "argv": [
            "${veld.root}/scripts/dev/electron.sh",
            "${veld.root}/.veld-dev/${veld.run}",
            "5"
          ],
          // The portless case, and the reason `"ports": null` exists at all.
          // Electron binds nothing; before this it had to be handed a port it
          // never used, or run outside veld and be forgotten at teardown.
          "ports": null,
          // Loopback, not `${nodes.dev-ui.url}`. Going through Caddy would
          // make Electron's Chromium the thing that has to trust veld's local
          // CA, and a cert it dislikes is a blank window with the reason only
          // in devtools. `just dev-desktop` has always pointed at vite
          // directly for the same reason. The browser path keeps the https
          // URL, where the system trust store already applies.
          // Variant-level, because it is the one value here that IS a
          // cross-node reference. Safe where the node-level map above is not:
          // nothing re-resolves a variant's env after the run is stopping.
          "env": { "VELD_DESKTOP_URL": "http://127.0.0.1:${nodes.dev-ui.port}" },
          // `settle`, and NOT a `command` probe asking whether Electron is up:
          // a probe's argv is not interpolated, so such a probe could never be
          // told which run's pidfile to look at. The supervisor closes the gap
          // instead by adopting the same window — it exits if Electron dies
          // inside these 5 seconds, so `settle` fails a bad start rather than
          // reporting on itself. Keep this number equal to the argv one above.
          //
          // Deliberately no LIVENESS probe: quitting Electron is a thing the
          // user is allowed to do, and a liveness failure means recovery.
          "probes": { "readiness": { "type": "settle", "seconds": 5 } }
        }
      }
    },

    "dev-link": {
      "depends_on": { "dev-daemon": "local" },
      // `${veld.*}` builtins ONLY. This map is resolved a second time for the
      // `on_stop` hook below, `build_env` is all-or-nothing, and a cross-node
      // reference cannot resolve once the run is stopping — so putting
      // `${nodes.dev-daemon.port}` here emptied the entire map at stop time and
      // left exactly the stale wrapper the hook exists to remove. The port goes
      // in `argv` instead, which is interpolated at start.
      "env": {
        "VELD_DEV_ROOT": "${veld.root}",
        "VELD_DEV_RUN": "${veld.run}",
        "VELD_DEV_DIR": "${veld.root}/.veld-dev/${veld.run}"
      },
      "default_variant": "local",
      "variants": {
        "local": {
          "type": "command",
          // Writes ~/.local/bin/veld-dev-<run>: the CLI that talks to THIS
          // run's dev instance, from any directory. It is what you point at a
          // real project to test veld against it.
          "argv": ["${veld.root}/scripts/dev/link.sh", "--write", "${nodes.dev-daemon.port}"],
          // Removed at stop, because what it carries is a live allocation. A
          // wrapper outliving its run points at a port nothing serves, which
          // is worse than no wrapper: the CLI reports an empty instance
          // instead of telling you the dev stack is down.
          "on_stop": { "argv": ["${veld.root}/scripts/dev/link.sh", "--remove"] }
        }
      }
    }
  }
}
