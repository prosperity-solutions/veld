# Rust / Cargo
/target/
**/target/
**/*.rs.bk
# Cargo.lock is tracked for reproducible binary builds

# Veld runtime directories
.veld/
**/.veld/

# Dedicated SQLite state for source-built binaries (`just dev` tier)
/.veld-dev/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# macOS
.DS_Store

# Scratch space (design handoffs, local experiments)
/tmp/

# Frontend build
node_modules/
crates/veld-daemon/ui/dist/

# Packaged Veld Desktop builds (electron-builder output; dist-deb is the .deb's
# separate output dir — see desktop/electron-builder.yml)
desktop/dist/
desktop/dist-deb/

# Working documents — RFCs, PRDs, plans, scratch notes. Never tracked (see AGENTS.md).
/notes/

# Environment / secrets
.env
.env.local
*.pem
*.key
.claude/settings.local.json
/package-lock.json
/package.json

# Review scaffolding (context pack, ledger) — never committed.
.review/

# Ship-workflow run marker (docs/ship.md Step 0). Holds the kickoff answers for
# this worktree's run; the local nag hooks and Step 5's PR footer read it.
.veld-ship.json
