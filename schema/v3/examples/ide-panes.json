{
  "$schema": "https://veld.oss.life.li/schema/v3/veld.schema.json",
  "schemaVersion": "3",
  "name": "ide-panes",
  // Panes this project adds to Veld Desktop's pane menu. Nothing here is
  // specific to a vendor: veld only knows how to run a command in a terminal
  // and how to hand it a stable token, and the config decides what that
  // command is.
  "ide": {
    // A command that names a new worktree from the prompt the IDE's New
    // worktree dialog was given. The prompt arrives on **stdin**, not in the
    // argument list — which is both how `claude -p` and `codex exec` already
    // take one, and why a prompt (the user's own prose, about whatever they are
    // working on) never reaches the world-readable process table.
    //
    // It runs after the checkout exists, so nothing waits on it: the dialog has
    // already named the worktree from the prompt's first clause, and this
    // replaces that label a few seconds later if it answers. Every failure is
    // silent on purpose — the name the dialog chose stands.
    "worktreeName": {
      "argv": [
        "claude",
        "-p",
        "Reply with a 2-4 word title for this task, in sentence case, and nothing else"
      ]
    },
    "panes": [
      {
        // The worked example. `claude --session-id <uuid>` starts a
        // conversation under an id veld chose, so `claude --resume <same uuid>`
        // can pick that exact conversation back up after a reboot — even
        // though the shell itself is long gone.
        "id": "claude",
        "type": "terminal",
        // Claude sets a dynamic terminal title (OSC 0/2) naming the task it is
        // working on, and a pane adopts it — so there is no flag here. That is
        // what makes a rail of agent panes tellable apart, and it is why this
        // `label` is what the tab is called only until the tool says otherwise.
        "label": "Claude",
        "description": "Claude Code in this worktree",
        "icon": "sparkles",
        "requires_bin": ["claude"],
        "argv": ["claude", "--session-id", "${veld.pane.token}"],
        "resume": { "argv": ["claude", "--resume", "${veld.pane.token}"] },
        // The other half of resuming: `resume` above picks up the session THIS
        // pane started, which is nothing at all the first time you open it in a
        // worktree. `sessions` names a command that finds the ones the tool
        // already has on disk, so a conversation from last week — or from before
        // this pane existed — is one click away.
        //
        // What the script prints is a value per line, optionally TAB a label and
        // TAB a detail. The value goes into ${veld.pane.token}, so `resume`
        // above is what runs; the script can never contribute a command, only
        // choose which session the declared one opens. Print nothing and the
        // choice is not offered at all.
        "sessions": {
          "label": "Resume an earlier Claude session",
          "argv": ["scripts/veld/claude-sessions.sh"]
        },
        "auto_resume": true
      },
      {
        // A second mode is a second pane, not a variant: panes have no
        // dependency graph and no preset to select them by, so the flat list
        // is the whole model. Each pane keeps its own token, so "which
        // conversation am I resuming" is never ambiguous.
        "id": "claude-yolo",
        "type": "terminal",
        "label": "Claude (skip permissions)",
        "icon": "bolt",
        "requires_bin": ["claude"],
        "argv": [
          "claude",
          "--dangerously-skip-permissions",
          "--session-id",
          "${veld.pane.token}"
        ],
        "resume": { "argv": ["claude", "--resume", "${veld.pane.token}"] },
        // The opposite call to the pane above, for the same reason a second
        // mode is a second pane: "which of these two is the unsafe one" is the
        // question this tab has to answer, and a live task title would take the
        // answer away. `fixed_label` pins the tab to `label`.
        "fixed_label": true
      },
      {
        // The other shape: `codex` mints its own session id and has no flag to
        // be told one, so this pane carries no token at all. `codex resume
        // --last` continues the most recent session, filtered to this
        // worktree — which still gives the pane a Resume button and still
        // works with `auto_resume`. What it gives up is per-pane identity: two
        // Codex panes here would resume the same session. Like the Claude pane
        // and unlike the one above it, this entry sets no `fixed_label`, so the
        // tab follows whatever title codex gives itself. Add
        // `"fixed_label": true` if you would rather it always read "Codex".
        "id": "codex",
        "type": "terminal",
        "label": "Codex",
        "icon": "robot",
        "requires_bin": ["codex"],
        "argv": ["codex"],
        "resume": { "argv": ["codex", "resume", "--last"] },
        // Stated rather than left to be inferred. The panes above rely on the
        // inference — they declare a `resume`, so the New worktree dialog reads
        // them as agents and offers them its prompt — and it would get this one
        // right too. It is spelled out here because that is the field's whole
        // job: to be the answer when "does this pane declare a resume command"
        // and "is this pane a coding agent" come apart.
        "agent": true
      },
      {
        // A pane needs neither a resume command nor a session id. This one is
        // just a shortcut that saves typing, and an emoji stands in for a
        // Tabler icon name.
        "id": "logs",
        "type": "terminal",
        "label": "Tail the dev log",
        "icon": "📜",
        "shell": "tail -f \"${veld.root}/tmp/dev.log\"",
        // The other direction, and redundant here — a pane with no `resume` is
        // not offered a prompt anyway. Worth writing when a pane *is* resumable
        // and still is not an agent, which is how a `psql` or a `git log` pane
        // stays out of a picker that would otherwise type a sentence into it.
        "agent": false
      }
    ]
  },
  "nodes": {
    "web": {
      "type": "start_server",
      "default_variant": "dev",
      "probes": { "readiness": { "type": "port" } },
      "variants": {
        "dev": { "argv": ["npm", "run", "dev"] }
      }
    }
  }
}
