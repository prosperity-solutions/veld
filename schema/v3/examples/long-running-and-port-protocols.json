{
  "$schema": "../veld.schema.json",
  "schemaVersion": "3",
  "name": "long-running-and-port-protocols",
  "url_template": "{service}.{run}.demo.localhost",

  // Environment-wide sharing policy. Relays must be opted into explicitly —
  // including public — so nothing is routed over a public relay by accident.
  //
  // The two TTLs are how long a share LINK lives, per audience, in minutes. They
  // are the deadline that usually ends a share, and therefore what ends the
  // automatic keep-awake with it — `keepAwake.sharing*Minutes` is a ceiling over
  // this, not a second countdown. Set here, a project's answer overrides each
  // machine's `sharing.peerTtlMinutes` / `sharing.webTtlMinutes` setting, and
  // `veld share --ttl` overrides both for one share.
  "sharing": {
    "relays": "public",
    "peer_ttl_minutes": 240,
    "web_ttl_minutes": 30
  },

  "nodes": {
    // The default shape, unchanged: no `ports` key means one auto-allocated
    // http port, reachable at web.<run>.demo.localhost.
    "web": {
      "variants": {
        "dev": {
          "type": "long_running",
          "shell": "vite --port ${veld.port}",
          "probes": { "readiness": { "type": "http", "path": "/" } }
        }
      }
    },

    // Several ports, two protocols. `admin` is explicitly http, so it gets its
    // own hostname — api-admin.<run>.demo.localhost, a sibling of the primary
    // rather than a deeper label, so an existing wildcard cert still covers it.
    //
    // `postgres` and `debug` are tcp. They get a hostname and a DNS entry too —
    // naming and routing are separate — but no Caddy route, because a raw TCP
    // connection carries no hostname to match on. So the address is
    // api-postgres.<run>.demo.localhost:5432, reached directly.
    "api": {
      "variants": {
        "dev": {
          "type": "long_running",
          "shell": "api --port ${veld.port} --admin ${veld.ports.admin}",
          // Consent is per port. `http` is offered to peers and the web; the
          // ops console and the database are not shared at all, and the node
          // has no way to say otherwise in one stroke. `postgres` opts into
          // peer sharing only — `web` would be a lint error, because the
          // gateway serves HTTP and a browser cannot speak postgres.
          "ports": {
            "http": { "port": "auto", "protocol": "http", "share": { "expose": ["peer", "web"] } },
            "admin": { "port": "auto", "protocol": "http" },
            "postgres": { "port": 5432, "protocol": "tcp", "share": { "expose": ["peer"] } },
            "debug": "auto"
          },
          "env": {
            // A routed port has a URL; every port has a hostname.
            "ADMIN_ORIGIN": "${veld.urls.admin.origin}",
            "DATABASE_URL": "postgres://app@${veld.hosts.postgres}:${veld.ports.postgres}/app"
          },
          "probes": { "readiness": { "type": "port" } }
        }
      }
    },

    // A port whose derived hostname would collide gets its own template.
    //
    // `host` replaces `url_template`, so it speaks the same {single-brace}
    // language — {service}, {variant}, {run}, {project}, {branch}, {worktree},
    // {username}, {hostname}, and the {a ?? b} fallback. NOT ${...}: that is the
    // command/env language, and ${vars.x} here is a start-time error.
    // Inside a `host`, {service} is the port's own label — the node name for a
    // primary port, `<node>-<port>` for a secondary one.
    "docs": {
      "variants": {
        "dev": {
          "type": "long_running",
          "shell": "docs-server --port ${veld.port}",
          "ports": {
            "http": {
              "port": "auto",
              "protocol": "http",
              "host": "handbook.{branch ?? run}.{project}.localhost"
            }
          },
          "probes": { "readiness": { "type": "http", "path": "/index.html" } }
        }
      }
    },

    // The portless case: a supervised process that serves nothing. `settle`
    // only claims the process was still alive after 5s — but it is raced
    // against process exit, so a command that dies on startup fails the run.
    "electron": {
      "depends_on": { "web": "dev" },
      "variants": {
        "dev": {
          "type": "long_running",
          "shell": "electron .",
          "ports": null,
          "env": { "APP_URL": "${nodes.web.url}" },
          "probes": { "readiness": { "type": "settle", "seconds": 5 } }
        }
      }
    },

    // A watcher, readied by something observable rather than by a timer.
    "codegen": {
      "variants": {
        "watch": {
          "type": "long_running",
          "shell": "codegen --watch --out ./generated",
          "ports": null,
          "probes": {
            "readiness": { "type": "command", "shell": "test -f ./generated/index.ts" },
            "liveness": { "type": "command", "shell": "test -d ./generated" }
          }
        }
      }
    },

    // `start_server` remains a permanent alias for `long_running`.
    "legacy": {
      "variants": {
        "dev": {
          "type": "start_server",
          "shell": "serve --port ${veld.port}",
          "probes": { "readiness": { "type": "port" } }
        }
      }
    }
  }
}
