<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for everything inside the bundle — the Electron helper apps and
  frameworks, which are signed on their own rather than inheriting the outer
  signature's. Same keys as `entitlements.mac.plist`, where the reasoning lives;
  a separate file because electron-builder would otherwise fall back to its own
  bundled template for the helpers and they could drift apart unnoticed.
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
  </dict>
</plist>
